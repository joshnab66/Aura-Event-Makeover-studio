rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Global validation helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'phone', 'eventType', 'dateTime', 'approxBudget', 'guestCount', 'specialRequirements', 'createdAt'])
        && data.keys().size() == 10
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50
        && data.eventType is string && data.eventType.size() > 0 && data.eventType.size() <= 100
        && data.dateTime is string && data.dateTime.size() > 0 && data.dateTime.size() <= 100
        && data.approxBudget is string && data.approxBudget.size() > 0 && data.approxBudget.size() <= 100
        && data.guestCount is int && data.guestCount >= 1 && data.guestCount <= 100000
        && data.specialRequirements is string && data.specialRequirements.size() <= 5000
        && data.createdAt is string && data.createdAt.size() <= 102;
    }

    match /bookings/{bookingId} {
      // Anyone is allowed to submit a booking if payload matches validation rules
      allow create: if isValidId(bookingId) && isValidBooking(request.resource.data);
      
      // Reading/listing bookings requires a signed-in session
      allow read: if isSignedIn();
      
      // Updating/deleting bookings requires being signed in as administrative role
      allow update, delete: if isSignedIn();
    }
  }
}
